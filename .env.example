# Copy to `.env` (project root) or `~/.nimcode/.env` (global fallback) and fill in.
# Local `.env` wins; real environment variables win over both.

# Required: NVIDIA NIM API key (https://build.nvidia.com)
NVIDIA_API_KEY=nvapi-...

# Optional: override the sidecar binary path (defaults to the bundled one).
# NIM_TUI_BIN=C:\path\to\nim-tui.exe

# Optional: model catalog refresh. Cache TTL in hours (default 24);
# set NIMCODE_NO_MODEL_REFRESH=1 to disable background refresh (air-gapped).
# NIMCODE_MODELS_TTL_HOURS=24
# NIMCODE_NO_MODEL_REFRESH=1

# Optional: plain-ASCII output (no unicode symbols or color).
# NIMCODE_ASCII=1
# NO_COLOR=1
