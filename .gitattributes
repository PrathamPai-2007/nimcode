# Normalize line endings to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf

# Python source files — always LF
*.py text eol=lf

# Config / markup files — always LF
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.cfg  text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.whl  binary
*.zip  binary
